      ],
      "full_rank_required": true,
      "max_condition_number": 100.0,
      "max_synthesis_nmse": 0.000001
    },
    "factor_activity": {
      "enabled": true,
      "metric": "coordinate_std",
      "minimum": 0.1,
      "coordinates": [
        {
          "factor_id": "pc_000",
          "coordinate_index": 0
        },
        {
          "factor_id": "pc_000",
          "coordinate_index": 1
        },
        {
          "factor_id": "pc_001",
          "coordinate_index": 0
        },
        {
