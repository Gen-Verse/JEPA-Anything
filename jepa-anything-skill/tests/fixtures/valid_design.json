          "coordinate_index": 1
        },
        {
          "factor_id": "pc_002",
          "coordinate_index": 0
        },
        {
          "factor_id": "pc_002",
          "coordinate_index": 1
        },
        {
          "factor_id": "pc_003",
          "coordinate_index": 0
        },
        {
          "factor_id": "pc_003",
          "coordinate_index": 1
        }
      ]
